+      pkg_search_module(MBEDCRYPTO OPTIONAL
+        mbedcrypto-3>=3.0.0
+        mbedcrypto>=3.0.0
+        mbedcrypto>=2.0.0)
+
+      set(MBEDTLS_LINK_LIBRARIES
+        ${MBEDTLS_LIBRARIES}
+      )
+
+      if(MBEDX509_FOUND)
