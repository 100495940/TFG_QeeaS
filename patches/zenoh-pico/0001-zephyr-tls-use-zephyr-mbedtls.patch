+  if(DEFINED ZP_PLATFORM AND ZP_PLATFORM STREQUAL "zephyr")
+        message(STATUS "Using Zephyr-provided Mbed TLS for zenoh-pico TLS")
+        message(STATUS "Skipping pkg-config lookup for Mbed TLS because target platform is Zephyr")
+
+        # En Zephyr no se debe buscar Mbed TLS mediante pkg-config.
+        # pkg-config resolvería las cabeceras y librerías del sistema Linux
+        # del contenedor (/usr/include, /usr/lib), lo que contamina la
+        # compilación cruzada para ESP32-C6.
+        #
+        # El soporte TLS debe venir del propio Zephyr mediante Kconfig:
