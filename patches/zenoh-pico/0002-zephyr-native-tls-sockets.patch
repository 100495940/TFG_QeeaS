diff --git a/src/system/zephyr/tls.c b/src/system/zephyr/tls.c
new file mode 100644
index 00000000..84723b50
--- /dev/null
+++ b/src/system/zephyr/tls.c
@@ -0,0 +1,345 @@
+//
+// Zephyr-native TLS backend for zenoh-pico
+//
+
+#include "zenoh-pico/config.h"
+
+#if Z_FEATURE_LINK_TLS == 1 && defined(ZENOH_ZEPHYR)
+
+#include "zenoh-pico/system/link/tls.h"
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <zephyr/net/socket.h>
+#include <zephyr/net/tls_credentials.h>
+
+#include "mbedtls/base64.h"
+
+#ifndef CONFIG_QEEAS_TLS_CA_BASE64
+#define CONFIG_QEEAS_TLS_CA_BASE64 ""
+#endif
+
+#ifndef ZENOHPICO_ZEPHYR_TLS_SEC_TAG
+#define ZENOHPICO_ZEPHYR_TLS_SEC_TAG 4242
+#endif
+
+#ifndef SOL_TLS
+#ifdef ZSOL_TLS
+#define SOL_TLS ZSOL_TLS
+#endif
+#endif
+
+#ifndef TLS_SEC_TAG_LIST
+#ifdef ZSOCK_TLS_SEC_TAG_LIST
+#define TLS_SEC_TAG_LIST ZSOCK_TLS_SEC_TAG_LIST
+#endif
+#endif
+
+#ifndef TLS_HOSTNAME
+#ifdef ZSOCK_TLS_HOSTNAME
+#define TLS_HOSTNAME ZSOCK_TLS_HOSTNAME
+#endif
+#endif
+
+#ifndef TLS_PEER_VERIFY
+#ifdef ZSOCK_TLS_PEER_VERIFY
+#define TLS_PEER_VERIFY ZSOCK_TLS_PEER_VERIFY
+#endif
+#endif
+
+#ifndef TLS_PEER_VERIFY_REQUIRED
+#ifdef ZSOCK_TLS_PEER_VERIFY_REQUIRED
+#define TLS_PEER_VERIFY_REQUIRED ZSOCK_TLS_PEER_VERIFY_REQUIRED
+#endif
+#endif
+
+static bool _z_zephyr_tls_ca_registered = false;
+static unsigned char *_z_zephyr_tls_ca_pem = NULL;
+static size_t _z_zephyr_tls_ca_pem_len = 0;
+
+static int _z_zephyr_tls_register_ca(void) {
+    const char *ca_base64 = CONFIG_QEEAS_TLS_CA_BASE64;
+    size_t ca_base64_len = strlen(ca_base64);
+    size_t required_len = 0;
+    size_t decoded_len = 0;
+    int ret;
+
+    if (_z_zephyr_tls_ca_registered) {
+        return 0;
+    }
+
+    if (ca_base64_len == 0) {
+        return -EINVAL;
+    }
+
+    ret = mbedtls_base64_decode(NULL, 0, &required_len,
+                                (const unsigned char *)ca_base64,
+                                ca_base64_len);
+
+    if (ret != 0 && required_len == 0) {
+        return ret;
+    }
+
+    _z_zephyr_tls_ca_pem = (unsigned char *)malloc(required_len + 1);
+    if (_z_zephyr_tls_ca_pem == NULL) {
+        return -ENOMEM;
+    }
+
+    ret = mbedtls_base64_decode(_z_zephyr_tls_ca_pem,
+                                required_len,
+                                &decoded_len,
+                                (const unsigned char *)ca_base64,
+                                ca_base64_len);
+
+    if (ret != 0) {
+        free(_z_zephyr_tls_ca_pem);
+        _z_zephyr_tls_ca_pem = NULL;
+        _z_zephyr_tls_ca_pem_len = 0;
+        return ret;
+    }
+
+    _z_zephyr_tls_ca_pem[decoded_len] = '\0';
+    _z_zephyr_tls_ca_pem_len = decoded_len + 1;
+
+    ret = tls_credential_add(ZENOHPICO_ZEPHYR_TLS_SEC_TAG,
+                             TLS_CREDENTIAL_CA_CERTIFICATE,
+                             _z_zephyr_tls_ca_pem,
+                             _z_zephyr_tls_ca_pem_len);
+
+    if (ret < 0 && ret != -EEXIST) {
+        free(_z_zephyr_tls_ca_pem);
+        _z_zephyr_tls_ca_pem = NULL;
+        _z_zephyr_tls_ca_pem_len = 0;
+        return ret;
+    }
+
+    _z_zephyr_tls_ca_registered = true;
+    return 0;
+}
+
+_z_tls_context_t *_z_tls_context_new(void) {
+    _z_tls_context_t *ctx = (_z_tls_context_t *)malloc(sizeof(_z_tls_context_t));
+
+    if (ctx == NULL) {
+        return NULL;
+    }
+
+    memset(ctx, 0, sizeof(_z_tls_context_t));
+    ctx->_enable_mtls = false;
+
+    return ctx;
+}
+
+void _z_tls_context_free(_z_tls_context_t **ctx) {
+    if (ctx == NULL || *ctx == NULL) {
+        return;
+    }
+
+    free(*ctx);
+    *ctx = NULL;
+}
+
+z_result_t _z_open_tls(_z_tls_socket_t *sock,
+                       const _z_sys_net_endpoint_t *rep,
+                       const char *hostname,
+                       const _z_str_intmap_t *config,
+                       bool peer_socket) {
+    struct zsock_addrinfo *it;
+    sec_tag_t sec_tag_list[] = { ZENOHPICO_ZEPHYR_TLS_SEC_TAG };
+    int fd = -1;
+    int ret;
+
+    (void)config;
+
+    if (sock == NULL || rep == NULL || rep->_iptcp == NULL) {
+        return (z_result_t)-1;
+    }
+
+    memset(sock, 0, sizeof(_z_tls_socket_t));
+    sock->_sock._fd = -1;
+    sock->_tls_ctx = _z_tls_context_new();
+    sock->_is_peer_socket = peer_socket;
+
+    if (sock->_tls_ctx == NULL) {
+        return (z_result_t)-1;
+    }
+
+    ret = _z_zephyr_tls_register_ca();
+    if (ret < 0) {
+        _z_tls_context_free(&sock->_tls_ctx);
+        return (z_result_t)-1;
+    }
+
+    for (it = (struct zsock_addrinfo *)rep->_iptcp; it != NULL; it = it->ai_next) {
+        fd = zsock_socket(it->ai_family, SOCK_STREAM, IPPROTO_TLS_1_2);
+        if (fd < 0) {
+            continue;
+        }
+
+        ret = zsock_setsockopt(fd,
+                         SOL_TLS,
+                         TLS_SEC_TAG_LIST,
+                         sec_tag_list,
+                         sizeof(sec_tag_list));
+        if (ret < 0) {
+            zsock_close(fd);
+            fd = -1;
+            continue;
+        }
+
+#ifdef TLS_PEER_VERIFY
+        {
+            int peer_verify = TLS_PEER_VERIFY_REQUIRED;
+
+            ret = zsock_setsockopt(fd,
+                             SOL_TLS,
+                             TLS_PEER_VERIFY,
+                             &peer_verify,
+                             sizeof(peer_verify));
+            if (ret < 0) {
+                zsock_close(fd);
+                fd = -1;
+                continue;
+            }
+        }
+#endif
+
+#ifdef TLS_HOSTNAME
+        if (hostname != NULL && strlen(hostname) > 0) {
+            ret = zsock_setsockopt(fd,
+                             SOL_TLS,
+                             TLS_HOSTNAME,
+                             hostname,
+                             strlen(hostname));
+            if (ret < 0) {
+                zsock_close(fd);
+                fd = -1;
+                continue;
+            }
+        }
+#else
+        (void)hostname;
+#endif
+
+        ret = zsock_connect(fd, it->ai_addr, it->ai_addrlen);
+        if (ret == 0) {
+            sock->_sock._fd = fd;
+            return (z_result_t)0;
+        }
+
+        zsock_close(fd);
+        fd = -1;
+    }
+
+    _z_tls_context_free(&sock->_tls_ctx);
+    return (z_result_t)-1;
+}
+
+z_result_t _z_listen_tls(_z_tls_socket_t *sock,
+                         const char *host,
+                         const char *port,
+                         const _z_str_intmap_t *config) {
+    (void)sock;
+    (void)host;
+    (void)port;
+    (void)config;
+
+    /*
+     * Este backend Zephyr inicial está orientado a cliente TLS.
+     * La ESP32-C6 en QeeaS actúa como cliente contra zenohd.
+     */
+    return (z_result_t)-1;
+}
+
+z_result_t _z_tls_accept(_z_sys_net_socket_t *socket,
+                         const _z_sys_net_socket_t *listen_sock) {
+    (void)socket;
+    (void)listen_sock;
+
+    /*
+     * Accept TLS no se usa en el cliente ESP32-C6.
+     */
+    return (z_result_t)-1;
+}
+
+void _z_close_tls(_z_tls_socket_t *sock) {
+    if (sock == NULL) {
+        return;
+    }
+
+    if (sock->_sock._fd >= 0) {
+        zsock_close(sock->_sock._fd);
+        sock->_sock._fd = -1;
+    }
+
+    _z_tls_context_free(&sock->_tls_ctx);
+
+    /*
+     * Si el socket TLS fue reservado por la capa superior como peer socket,
+     * zenoh-pico espera que se libere al cerrar TLS.
+     *
+     * OJO: de momento usamos free(), coherente con malloc() usado en este
+     * backend. Si más adelante queremos alinearlo totalmente con z_malloc(),
+     * cambiamos malloc/free por z_malloc/z_free.
+     */
+    if (sock->_is_peer_socket) {
+        free(sock);
+    }
+}
+
+size_t _z_read_tls(const _z_tls_socket_t *sock, uint8_t *ptr, size_t len) {
+    int ret;
+
+    if (sock == NULL || ptr == NULL || sock->_sock._fd < 0) {
+        return SIZE_MAX;
+    }
+
+    ret = zsock_recv(sock->_sock._fd, ptr, len, 0);
+    if (ret <= 0) {
+        return SIZE_MAX;
+    }
+
+    return (size_t)ret;
+}
+
+size_t _z_write_tls(const _z_tls_socket_t *sock, const uint8_t *ptr, size_t len) {
+    int ret;
+
+    if (sock == NULL || ptr == NULL || sock->_sock._fd < 0) {
+        return SIZE_MAX;
+    }
+
+    ret = zsock_send(sock->_sock._fd, ptr, len, 0);
+    if (ret < 0) {
+        return SIZE_MAX;
+    }
+
+    return (size_t)ret;
+}
+
+size_t _z_write_all_tls(const _z_tls_socket_t *sock, const uint8_t *ptr, size_t len) {
+    size_t written = 0;
+
+    if (sock == NULL || ptr == NULL) {
+        return SIZE_MAX;
+    }
+
+    while (written < len) {
+        size_t wb = _z_write_tls(sock, ptr + written, len - written);
+
+        if (wb == SIZE_MAX || wb == 0) {
+            return SIZE_MAX;
+        }
+
+        written += wb;
+    }
+
+    return written;
+}
+
+#endif  /* Z_FEATURE_LINK_TLS == 1 && defined(ZENOH_ZEPHYR) */
