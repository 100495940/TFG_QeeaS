@@ -27,6 +27,42 @@ extern "C" {
 
 #if Z_FEATURE_LINK_TLS == 1
 
+/*
+ * Zephyr-native TLS backend.
+ *
+ * En Zephyr no se utiliza directamente la API legacy de Mbed TLS
+ * usada por el backend Unix de zenoh-pico, porque Zephyr actual
+ * puede integrar Mbed TLS 4.x, donde ya no existen cabeceras como:
+ *
+ *   mbedtls/entropy.h
+ *   mbedtls/hmac_drbg.h
+ *
+ * En su lugar, la integración TLS para Zephyr se implementa sobre
+ * sockets TLS nativos de Zephyr:
+ *
+ *   socket(..., IPPROTO_TLS_1_2)
+ *   tls_credential_add(...)
+ *   setsockopt(..., TLS_SEC_TAG_LIST, ...)
+ */
+
+ #if defined(ZENOH_ZEPHYR)
+
+#include <zephyr/net/socket.h>
+#include <zephyr/net/tls_credentials.h>
+
+typedef struct {
+    /*
+     * Contexto mínimo para la variante Zephyr.
+     *
+     * La sesión TLS real la gestiona internamente el stack de sockets
+     * seguros de Zephyr. Por eso aquí no guardamos mbedtls_ssl_context,
+     * mbedtls_entropy_context ni mbedtls_hmac_drbg_context.
+     */
+    bool _enable_mtls;
+} _z_tls_context_t;
+
+#else
+
