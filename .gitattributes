cat > .gitattributes <<'EOF'
# Shell scripts must use Linux line endings
*.sh text eol=lf

# Source/config files
*.c text eol=lf
*.h text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
Kconfig text eol=lf
kconfig text eol=lf
prj.conf text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.json text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
EOF